# Sandbox-only defaults for the local MOON stack.
#
# These are NOT application secrets: they are the throw-away credentials of the
# WordPress install that runs inside this development sandbox. A real deployment
# uses its own administrator account and hosting credentials.
#
# This file is listed FIRST in the compose env_file order, so any real value in
# /run/base44/app.env overrides it.

# Local administrator created by sandbox/setup.sh.
MOON_ADMIN_USER=admin
MOON_ADMIN_PASSWORD=moon-demo
MOON_ADMIN_EMAIL=admin@moon.local

# Local demo content: seeded products are sample data, never required at runtime.
MOON_SEED_DEMO=1
