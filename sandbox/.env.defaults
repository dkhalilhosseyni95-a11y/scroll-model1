# Local, sandbox-only defaults. These are NOT third-party credentials: they are
# the throwaway WordPress admin account and the dev database name used inside the
# compose network. Real secrets are delivered by the platform at
# /run/base44/app.env, which is loaded after this file and therefore wins.
MOON_ADMIN_USER=admin
MOON_ADMIN_PASSWORD=moon-demo-2024
MOON_ADMIN_EMAIL=admin@moon.local
MOON_SITE_TITLE=MOON
